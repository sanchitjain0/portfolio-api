# Copy to .env for local development. On Render these are set in the dashboard / render.yaml.
NODE_ENV=development
PORT=8080
# MongoDB Atlas connection string (free M0 cluster). Database name goes in the path.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
# Admin login. Generate the hash with:  npm run hash-password -- 'your-strong-password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=
IP_HASH_SALT=
# Comma-separated origins allowed to call the public API (your portfolio)
CORS_ORIGINS=http://localhost:5173,https://sanchit-portfolio-chi.vercel.app
# Proxies in front of the app (Render = 1). Only their X-Forwarded-For entries are trusted.
TRUST_PROXY_HOPS=1
